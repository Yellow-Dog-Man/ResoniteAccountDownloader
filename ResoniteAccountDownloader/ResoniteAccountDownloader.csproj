<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <RootNamespace>ResoniteAccountDownloader</RootNamespace>
    <AssemblyName>Resonite Account Downloader</AssemblyName>
    <Company>Yellow Dog Man Studios</Company>
    <Version>1.0.0</Version>

    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <Configurations>Debug;Release;ReleaseNative</Configurations>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Should kill PDB -->
    <DebugType>none</DebugType>
    <DebugSymbols>False</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseNative'">
    <SelfContained>true</SelfContained>
    <!-- AOT -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />

    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />

    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />

    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />

    <!-- Reactive UI Stuff-->
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
    <PackageReference Include="Enums.NET" Version="5.0.0" />
    <PackageReference Include="MessagePack.Annotations" Version="2.5.305" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Connections.Common" Version="10.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />
    <!-- Avalonia.ReactiveUI 11.x is built against ReactiveUI 20 / Splat 15; newer versions fail at runtime (MissingMethodException) -->
    <PackageReference Include="ReactiveUI.Validation" Version="4.1.1" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="All" />

    <PackageReference Include="Splat" Version="15.5.3" />

    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SerilogTraceListener" Version="3.2.1-dev-00011" />

    <!-- Avalonia addons -->
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.7.0" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageReference Include="Deadpikle.AvaloniaProgressRing" Version="0.10.10" />
    <PackageReference Include="YellowDogMan.Elements.Core" Version="1.2.0" />

    <PackageReference Include="YellowDogMan.Hardware.Info" Version="101.1.1.1-ydm-0.2.2" />

    <!-- Generator Stuff -->
    <!-- Referenced as both an analyzer (runs the generator) and an assembly (for [StaticViewLocator]) -->
    <ProjectReference Include="..\AccountDownloader.Generators\AccountOperationUtilities.Generators.csproj" OutputItemType="Analyzer" />
    <ProjectReference Include="..\AccountOperationUtilities\AccountOperationUtilities.csproj" />

    <!-- External Libraries from Steam Build Stuff -->
    <Reference Include="Elements.Assets">
      <HintPath>..\ExternalLibraries\Elements.Assets.dll</HintPath>
    </Reference>
    <Reference Include="SkyFrost.Base">
      <HintPath>..\ExternalLibraries\SkyFrost.Base.dll</HintPath>
    </Reference>
    <Reference Include="SkyFrost.Base.Models">
      <HintPath>..\ExternalLibraries\SkyFrost.Base.Models.dll</HintPath>
    </Reference>

    <!-- Reference some dependencies that Elements.Core/SkyFrost needs -->
    <!-- TODO: Is there a smarterway to include them? -->
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.12" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="10.0.12" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="SignalR.Strong" Version="0.3.0.0" />
    <PackageReference Include="MessageFormat" Version="8.0.0" />
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />

  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- https://til.cazzulino.com/msbuild/detect-ci-builds-for-every-ci-system -->
  <Target Name="CopyContributors" BeforeTargets="Build" Condition="'$(CI)' == ''">
    <Message Text="Copying Contributors" Importance="High" />
    <Copy SourceFiles="..\.all-contributorsrc" DestinationFolder="Assets\" SkipUnchangedFiles="true" />
  </Target>
</Project>
